# Server Configuration
PORT=3000
NODE_ENV=development

# Admin Authentication
ADMIN_PASSWORD=

# Security & Verification
# OBRIGATÓRIO em produção: qualquer texto longo e aleatório (sem isso cada reinício invalida as verificações)
SIGNUP_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# AI Studio Gemini API (server-side)
GEMINI_API_KEY=

# Banco de dados no Firestore (opcional). NÃO coloque estas chaves aqui sem necessidade: o AI Studio cria um Secret
# obrigatório para cada nome listado neste arquivo. Se precisar, crie-as direto no painel de Secrets:
#   FIREBASE_PROJECT_ID, FIREBASE_DATABASE_ID, FIREBASE_SERVICE_ACCOUNT (JSON da chave) ou PERSISTENCE=file
