# Server Configuration
PORT=3000
NODE_ENV=development

# Admin Authentication
ADMIN_PASSWORD=

# Security & Verification
# OBRIGATÓRIO em produção: qualquer texto longo e aleatório (sem isso cada reinício invalida as verificações)
SIGNUP_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# AI Studio Gemini API (server-side)
GEMINI_API_KEY=

# Banco de dados no Firestore (servidor). JSON da conta de serviço (ou em base64). Veja LEIA-ME.md
FIREBASE_SERVICE_ACCOUNT=
# FIREBASE_PROJECT_ID=    (sem chave de serviço: projeto do Firestore, ex.: big-hook-jv4kj)
# FIREBASE_DATABASE_ID=   (opcional; padrão: o banco "(default)" do projeto da chave)
# PERSISTENCE=file  (força usar os arquivos JSON antigos)
