        username: 'Ana Beatriz (Aluna)',
        avatarUrl: 'https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=150&auto=format&fit=crop&q=80',
        xp: 1450,
        level: 10,
        gems: 480,
        hearts: 5,
        streak: 14,
        completedLessonsCount: 18,
        lastActive: 'Hoje',
        activeTitle: 'Sinalizadora Ágil',
        equippedSkin: 'skin_esmeralda',
      },
      {
        key: 'USER_marcos_silva',
        syncCode: 'LIB-3120',
        username: 'Marcos Silva',
        avatarUrl: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=150&auto=format&fit=crop&q=80',
        xp: 820,
        level: 6,
        gems: 195,
        hearts: 4,
        streak: 7,
        completedLessonsCount: 9,
        lastActive: 'Ontem',
        activeTitle: 'Aprendiz Curioso',
        equippedSkin: 'skin_celeste',
      },
      {
        key: 'USER_lucas_santos',
        syncCode: 'LIB-5541',
        username: 'Lucas Santos',
        avatarUrl: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=150&auto=format&fit=crop&q=80',
        xp: 2200,
        level: 15,
        gems: 710,
        hearts: 5,
        streak: 25,
        completedLessonsCount: 28,
        lastActive: 'Hoje',
        activeTitle: 'Intérprete Estelar',
        equippedSkin: 'skin_obsidiana',
      },
    ];
